# GTFS-Feed (bundesweiter Nahverkehr, wird auf MVB-Tram gefiltert)
GTFS_FEED_URL=https://download.gtfs.de/germany/nv_free/latest.zip

# Eingrenzung auf Magdeburg: Substring-Filter auf agency_name (Fallback agency_id).
# Leer lassen = alle Trams importieren (route_type=0).
GTFS_AGENCY_FILTER="Magdeburger Verkehrsbetriebe"

# Engine-API
ENGINE_BASE_URL=http://localhost:8000
COLLECTOR_API_TOKEN=

# HTTP-Timeout je Engine-Request in Sekunden. stop_times gehen in Chunks raus; auf
# langsamer Leitung darf ein Chunk dauern. Default 300.
ENGINE_TIMEOUT_SECONDS=300

# Logging: rotierende Tagesdatei (zusaetzlich zu stdout) ist Default.
# Leer = collector/storage/logs/collector.log. Setzen, um den Ort zu ueberschreiben
# (z.B. /var/log/mdtakt/collector.log auf dem NAS).
COLLECTOR_LOG_PATH=

# Feed-Archiv: jede heruntergeladene GTFS-ZIP wird hier abgelegt (~260 MB je Lauf,
# woechentlich also ~13 GB/Jahr). Leer = collector/storage/archive.
#
# WICHTIG, solange das Konsolidat (FAHRPLANPERIODEN Phase C) fehlt: Der Engine-Import
# ersetzt den Roh-Bestand, gespeichert wird bisher nur, DASS sich ein Fahrplan geaendert
# hat. Aus dem Archiv laesst sich der Fahrplan-Inhalt spaeter rueckwirkend konsolidieren.
# Auf "off" setzen deaktiviert die Archivierung -- dann sind vergangene Fahrplaene
# endgueltig verloren.
GTFS_ARCHIVE_PATH=

# Import-State (merkt sich letzten erfolgreichen Import: etag/sha256).
# Leer = collector/storage/state/last-import.json. Ueberspringt unveraenderte Feeds.
COLLECTOR_STATE_PATH=
