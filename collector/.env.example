# GTFS-Feed (bundesweiter Nahverkehr, wird auf MVB-Tram gefiltert)
GTFS_FEED_URL=https://download.gtfs.de/germany/nv_free/latest.zip

# Eingrenzung auf Magdeburg: Substring-Filter auf agency_name (Fallback agency_id).
# Leer lassen = alle Trams importieren (route_type=0).
GTFS_AGENCY_FILTER="Magdeburger Verkehrsbetriebe"

# Engine-API
ENGINE_BASE_URL=http://localhost:8000
COLLECTOR_API_TOKEN=

# Logging: rotierende Tagesdatei (zusaetzlich zu stdout) ist Default.
# Leer = collector/storage/logs/collector.log. Setzen, um den Ort zu ueberschreiben
# (z.B. /var/log/mdtakt/collector.log auf dem NAS).
COLLECTOR_LOG_PATH=

# Import-State (merkt sich letzten erfolgreichen Import: etag/sha256).
# Leer = collector/storage/state/last-import.json. Ueberspringt unveraenderte Feeds.
COLLECTOR_STATE_PATH=
