{
    "name": "mdtakt/collector",
    "description": "MD-Takt Collector — GTFS-Import und Sichtungs-Sync (CLI, laeuft auf dem NAS)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "symfony/console": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MdTakt\\Collector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MdTakt\\Collector\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/collector"],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
