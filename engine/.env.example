APP_NAME="MD-Takt Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mdtakt
DB_USERNAME=mdtakt
DB_PASSWORD=
DB_TIMEZONE=UTC

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync`, nicht `database`: Der Migrations-Satz enthält keine `jobs`-Tabelle (dieselbe
# Stolperfalle wie SESSION_DRIVER und CACHE_STORE). Aktuell stellt nichts in die Queue —
# mit `database` würde der erste Job, der es täte, still scheitern.
QUEUE_CONNECTION=sync

# WICHTIG: `file`, nicht `database`. Der Migrations-Satz enthält keine `cache`-Tabelle
# (gleiche Stolperfalle wie SESSION_DRIVER). Das Rate-Limit der Collector-Endpunkte liegt
# im Cache — mit `database` scheitert damit jeder Import-Request.
CACHE_STORE=file

# Origins, die die API im Browser aufrufen dürfen (kommagetrennt, ohne Leerzeichen).
# Lokal der Vite-Dev-Server, in Produktion die Admin- und Viewer-Subdomain.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Collector API-Token (statischer Schlüssel, mind. 32 Zeichen)
COLLECTOR_API_TOKEN=

# Admin-Zugang (Single-Admin, via Seeder angelegt: `php artisan db:seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Matching-Algorithmus
MATCHING_WINDOW_MINUTES=10
