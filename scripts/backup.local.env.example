# Kopiere nach backup.local.env (gitignored) und trage die Werte ein.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Zielverzeichnis der Dumps — auf einem anderen Geraet als die Datenbank.
BACKUP_DIR=/pfad/zu/backups/mdtakt

# Client-Image; die Version muss mindestens so neu sein wie der Server.
PG_IMAGE=postgres:17-alpine

# Auf Synology liegt docker nicht im PATH.
DOCKER_BIN=/usr/local/bin/docker

RETENTION_DAYS=30
