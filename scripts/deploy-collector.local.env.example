# Kopiere nach deploy-collector.local.env (gitignored) und trage die Werte ein.

SSH_ALIAS=mein-nas
REMOTE_DIR=/pfad/zum/collector

# Auf Synology liegt docker nicht im PATH.
DOCKER_BIN=/usr/local/bin/docker

# Falls der SSH-Nutzer den Docker-Socket direkt erreicht, hier leer lassen.
REMOTE_SUDO=sudo
