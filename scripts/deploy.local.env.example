# Kopiere diese Datei nach scripts/deploy.local.env und trage die Werte ein.
# deploy.local.env ist gitignored — Hostnamen, Pfade und Kontonamen gehören nicht ins Repo.

# SSH-Ziel (Alias aus ~/.ssh/config oder benutzer@host)
SSH_ALIAS=mein-host

# Basisverzeichnis auf dem Server; darunter liegen api/, admin/ und viewer/
REMOTE_BASE=/pfad/zu/public_html/domain.de/mdtakt

# PHP-Binary auf dem Server (Laravel 13 braucht 8.3+)
PHP_BIN=php84

# Basis-URL der API — wird beim Admin-Build in das Bundle kompiliert
API_BASE_URL=https://api.beispiel.de
